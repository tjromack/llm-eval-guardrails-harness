# Copy to .env and fill in. Never commit .env.  (Synthetic/public test data only.)

# ---- Judge (Phase 5) ----
# Provider for the LLM-as-judge: "anthropic" (default) or "ollama" (local, privacy-preserving).
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Judge model id (recorded with every judged score for calibration/versioning).
JUDGE_MODEL=claude-opus-4-8
# Ollama (only used when MODEL_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Target: RAG copilot adapter (Phase 2) ----
# The harness reaches targets ONLY through an adapter. Pick one transport.
# "http"  -> POST case input to RAG_COPILOT_URL, read output/trace from JSON.
# "command" -> run RAG_COPILOT_CMD as a subprocess, pass input on stdin, read stdout.
#
# Out of the box we point at the bundled SYNTHETIC stand-in target via the command
# transport, so the demo runs cold with no separate server. Point these at the real
# copilot to grade it. (Use the interpreter from your .venv for `python` below.)
RAG_COPILOT_ADAPTER=command
RAG_COPILOT_URL=http://localhost:8000/answer
RAG_COPILOT_CMD=python tools/fake_rag_copilot.py
#
# --- Grade the REAL copilot ---
# PREFERRED (fast): start the copilot server (`make run` in postpay-regulatory-copilot),
# then set:  RAG_COPILOT_ADAPTER=http   RAG_COPILOT_URL=http://localhost:8000/answer
#   A warm server means NO per-case model reload — the `/answer` endpoint (copilot DEC 014)
#   returns {text, citations, ...} which this adapter reads directly.
# FALLBACK (no server): RAG_COPILOT_ADAPTER=command  RAG_COPILOT_CMD=python tools/real_rag_copilot.py
#   Spawns the copilot's venv per case (reloads the model each time — slow but self-contained).
# Reported as the target "version" stamped on each run (prompt/model revision under test).
RAG_COPILOT_VERSION=baseline

# ---- Harness storage ----
HARNESS_DB=data/harness.db

# ---- Server ----
HOST=127.0.0.1
PORT=8000
