# Copy to .env and fill in. Never commit .env.  (Synthetic/public test data only.)

# ---- Judge (Phase 5) ----
# Provider for the LLM-as-judge: "anthropic" (default) or "ollama" (local, privacy-preserving).
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Judge model id (recorded with every judged score for calibration/versioning).
JUDGE_MODEL=claude-opus-4-8
# Ollama (only used when MODEL_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Target: RAG copilot adapter (Phase 2) ----
# The harness reaches targets ONLY through an adapter. Pick one transport.
# "http"  -> POST case input to RAG_COPILOT_URL, read output/trace from JSON.
# "command" -> run RAG_COPILOT_CMD as a subprocess, pass input on stdin, read stdout.
RAG_COPILOT_ADAPTER=http
RAG_COPILOT_URL=http://localhost:8001/ask
RAG_COPILOT_CMD=
# Reported as the target "version" stamped on each run (prompt/model revision under test).
RAG_COPILOT_VERSION=baseline

# ---- Harness storage ----
HARNESS_DB=data/harness.db

# ---- Server ----
HOST=127.0.0.1
PORT=8000
